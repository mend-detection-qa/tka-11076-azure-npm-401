# TKA-11076 repro lever.
#
# The first DP scan (ea49f928, agent 26.9.2.1) resolved pnpm-lock.yaml STATICALLY and
# never ran `pnpm install`, so it never fetched a tarball, never authenticated to the
# Azure feed, and could not reproduce the customer's 401.
#
# The customer's install is forced by the Gradle engine's React Native pre-step
# ("React Native project detected - installing node_modules before Gradle resolution").
# runPreStep forces an install here without needing the whole RN + Gradle shape.
npm.resolveDependencies=true
npm.runPreStep=true
npm.ignoreScripts=true
